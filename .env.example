# Required: OpenAI API key used by Agent 2 (screening) and Agent 3 (synthesis).
OPENAI_API_KEY=

# Optional: NCBI E-utilities API key. Not required at low volume.
# With a key PubMed allows 10 req/s instead of 3 req/s.
NCBI_API_KEY=

# Optional: Semantic Scholar API key. Not required at low volume.
SEMANTIC_SCHOLAR_API_KEY=
